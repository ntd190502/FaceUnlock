<Window x:Class="FaceUnlock.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" WindowState="Maximized" Topmost="True" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#060914" Foreground="#F8FAFC" FontFamily="Segoe UI">
    <Window.Resources>
        <Storyboard x:Key="AmbientMotion" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="AmbientOne" Storyboard.TargetProperty="Opacity" From=".26" To=".48" Duration="0:0:12" />
            <DoubleAnimation Storyboard.TargetName="BlueWaveMove" Storyboard.TargetProperty="X" From="-70" To="70" Duration="0:0:12" />
            <DoubleAnimation Storyboard.TargetName="BlueWaveMove" Storyboard.TargetProperty="Y" From="-18" To="18" Duration="0:0:12" />
            <DoubleAnimation Storyboard.TargetName="AmbientTwo" Storyboard.TargetProperty="Opacity" From=".22" To=".43" Duration="0:0:14" />
            <DoubleAnimation Storyboard.TargetName="VioletWaveMove" Storyboard.TargetProperty="X" From="80" To="-80" Duration="0:0:14" />
            <DoubleAnimation Storyboard.TargetName="VioletWaveMove" Storyboard.TargetProperty="Y" From="22" To="-22" Duration="0:0:14" />
        </Storyboard>
        <Storyboard x:Key="GlassBreathing" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="OuterGlow" Storyboard.TargetProperty="Opacity" From=".34" To=".55" Duration="0:0:5" />
            <DoubleAnimation Storyboard.TargetName="EdgeBorder" Storyboard.TargetProperty="Opacity" From=".58" To=".88" Duration="0:0:5" />
            <DoubleAnimation Storyboard.TargetName="TopReflection" Storyboard.TargetProperty="Opacity" From=".22" To=".43" Duration="0:0:5" />
        </Storyboard>
        <Storyboard x:Key="BorderFlow" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="FlowMove" Storyboard.TargetProperty="X" From="-200" To="850" Duration="0:0:7" />
        </Storyboard>
        <Storyboard x:Key="OrbitMotion" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="OrbitRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3.3" />
            <DoubleAnimation Storyboard.TargetName="OrbitCounterRotate" Storyboard.TargetProperty="Angle" From="360" To="0" Duration="0:0:9" />
        </Storyboard>
        <Storyboard x:Key="PhoneMotion" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PhoneFloat" Storyboard.TargetProperty="Y" From="-3" To="3" Duration="0:0:4.3" />
            <DoubleAnimation Storyboard.TargetName="PhoneGlow" Storyboard.TargetProperty="Opacity" From=".42" To=".88" Duration="0:0:3.5" />
            <DoubleAnimation Storyboard.TargetName="PhoneReflection" Storyboard.TargetProperty="Opacity" From=".16" To=".38" Duration="0:0:3.5" />
        </Storyboard>
        <Storyboard x:Key="OnlinePulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="OnlineDot" Storyboard.TargetProperty="Opacity" From=".68" To="1" Duration="0:0:1.5" />
            <DoubleAnimation Storyboard.TargetName="OnlineHalo" Storyboard.TargetProperty="Opacity" From=".08" To=".38" Duration="0:0:1.5" />
        </Storyboard>
        <Storyboard x:Key="BluetoothPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="BluetoothGlow" Storyboard.TargetProperty="Opacity" From=".12" To=".44" Duration="0:0:1.8" />
        </Storyboard>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid.Background>
            <RadialGradientBrush GradientOrigin=".52,.42" Center=".5,.5" RadiusX=".85" RadiusY=".85">
                <GradientStop Color="#111A36" Offset="0" /><GradientStop Color="#060914" Offset=".72" /><GradientStop Color="#02030A" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>
        <Ellipse x:Name="AmbientOne" Width="1370" Height="440" Fill="#4B1878FF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-540,-40,0,0">
            <Ellipse.RenderTransform><TranslateTransform x:Name="BlueWaveMove" /></Ellipse.RenderTransform>
            <Ellipse.Effect><BlurEffect Radius="138" /></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="AmbientTwo" Width="1300" Height="430" Fill="#533D209E" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,75,-520,0">
            <Ellipse.RenderTransform><TranslateTransform x:Name="VioletWaveMove" /></Ellipse.RenderTransform>
            <Ellipse.Effect><BlurEffect Radius="142" /></Ellipse.Effect>
        </Ellipse>

        <Grid Width="820" Height="455" Margin="0,-18,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="OuterGlow" CornerRadius="44" Margin="-10" Opacity=".42" BorderThickness="2">
                <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#804ACDFF" /><GradientStop Color="#00B88CFF" Offset=".48" /><GradientStop Color="#806E54FF" Offset="1" /></LinearGradientBrush></Border.BorderBrush>
                <Border.Effect><DropShadowEffect Color="#6A4E72FF" BlurRadius="54" ShadowDepth="0" Opacity=".65" /></Border.Effect>
            </Border>
            <Border CornerRadius="42" Margin="0,5,0,-5" Background="#9D01030A">
                <Border.Effect><DropShadowEffect Color="#E3000108" BlurRadius="19" ShadowDepth="12" Opacity=".72" /></Border.Effect>
            </Border>
            <Border x:Name="EdgeBorder" CornerRadius="42" BorderThickness="1.3" Opacity=".70">
                <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#D27AE0FF" /><GradientStop Color="#508EB8E8" Offset=".45" /><GradientStop Color="#C4B57DFF" Offset="1" /></LinearGradientBrush></Border.BorderBrush>
                <Border x:Name="GlassMaterial" CornerRadius="41" Margin="1" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#C41B2C49" /><GradientStop Color="#A20C172A" Offset=".52" /><GradientStop Color="#BF211937" Offset="1" /></LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse Width="640" Height="240" Fill="#2417B8FF" Opacity=".42" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-140,-140,0,0"><Ellipse.Effect><BlurEffect Radius="68" /></Ellipse.Effect></Ellipse>
                        <Border x:Name="TopReflection" Height="78" CornerRadius="41,41,0,0" VerticalAlignment="Top" Opacity=".32">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#75E6F5FF" /><GradientStop Color="#00D7F3FF" Offset="1" /></LinearGradientBrush></Border.Background>
                        </Border>
                        <Canvas Height="3" VerticalAlignment="Top" ClipToBounds="True" Opacity=".48">
                            <Border Width="180" Height="3" CornerRadius="2" Background="#C8EFFFFF"><Border.RenderTransform><TranslateTransform x:Name="FlowMove" /></Border.RenderTransform></Border>
                        </Canvas>
                        <Grid Margin="50,21,50,24">
                            <Grid.RowDefinitions><RowDefinition Height="145" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="22" /><RowDefinition Height="1" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Width="164" Height="145" HorizontalAlignment="Center">
                                <Grid Width="154" Height="154" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid.RenderTransform><RotateTransform x:Name="OrbitRotate" CenterX="77" CenterY="77" /></Grid.RenderTransform>
                                    <Path Data="M 29,93 A 62,62 0 0 1 117,29" Stroke="#5BC6FF" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path Data="M 111,30 A 62,62 0 0 1 137,94" Stroke="#B78AFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity=".68" />
                                    <Ellipse Width="11" Height="11" Fill="#D9F7FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,19,0"><Ellipse.Effect><DropShadowEffect Color="#6BD0FF" BlurRadius="12" ShadowDepth="0" Opacity=".9" /></Ellipse.Effect></Ellipse>
                                    <Ellipse Width="7" Height="7" Fill="#91CFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,37,27,0" Opacity=".54" />
                                    <Ellipse Width="5" Height="5" Fill="#B89BFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,47,32,0" Opacity=".28" />
                                </Grid>
                                <Grid Width="142" Height="142" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid.RenderTransform><RotateTransform x:Name="OrbitCounterRotate" CenterX="71" CenterY="71" /></Grid.RenderTransform>
                                    <Path Data="M 19,69 A 57,57 0 0 1 73,14" Stroke="#8F9CFF" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity=".55" />
                                </Grid>
                                <Border Width="58" Height="108" CornerRadius="15" Background="#BD142238" BorderThickness="2" BorderBrush="#C7E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.RenderTransform><TranslateTransform x:Name="PhoneFloat" /></Border.RenderTransform>
                                    <Border.Effect><DropShadowEffect x:Name="PhoneGlow" Color="#7084B9FF" BlurRadius="21" ShadowDepth="0" Opacity=".62" /></Border.Effect>
                                    <Grid ClipToBounds="True"><Rectangle Width="27" Height="4" RadiusX="2" RadiusY="2" Fill="#B6D8F4" VerticalAlignment="Top" Margin="0,11,0,0" /><Border x:Name="PhoneReflection" Height="27" VerticalAlignment="Top" Opacity=".22"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#9BEAFF" /><GradientStop Color="#009BEAFF" Offset="1" /></LinearGradientBrush></Border.Background></Border></Grid>
                                </Border>
                                <Path x:Name="SuccessCheck" Data="M 0,13 L 9,22 L 27,3" Stroke="#8CF2C5" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <Grid Grid.Row="1" x:Name="StatusVisual" RenderTransformOrigin=".5,.5"><Grid.RenderTransform><TranslateTransform x:Name="StatusMove" /></Grid.RenderTransform>
                                <TextBlock x:Name="StatusTitle" Text="Waiting for iPhone" FontSize="32" FontWeight="SemiBold" Foreground="#ECF6FF" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="2" x:Name="StatusDetail" Text="Connecting to your iPhone to unlock" Margin="0,8,0,0" FontSize="17" Foreground="#B8C5DA" HorizontalAlignment="Center" TextAlignment="Center" />
                            <Border Grid.Row="5" Height="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#006C8CA8" /><GradientStop Color="#566C8CA8" Offset=".5" /><GradientStop Color="#006C8CA8" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                            <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="14" Height="14" Margin="0,0,9,0"><Ellipse x:Name="OnlineHalo" Fill="#654EE49A" Opacity=".18" Margin="-2" /><Ellipse x:Name="OnlineDot" Width="9" Height="9" Fill="#54E49A" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><TextBlock x:Name="OnlineStatus" Text="Online" FontSize="16" Foreground="#BFEFD7" /></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Grid Width="29" Height="30" Margin="0,0,7,0"><Ellipse x:Name="BluetoothGlow" Fill="#4557AEFF" Opacity=".2" Margin="1" /><Path Data="M 10,2 L 20,12 L 14,18 L 20,24 L 10,34 L 10,22 L 4,28 L 4,23 L 10,17 L 4,11 L 4,6 L 10,12 Z" Stroke="#93D4FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><TextBlock x:Name="BluetoothStatus" Text="Bluetooth Ready" FontSize="16" Foreground="#C3D9EF" /></StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-88">
                <Path Data="M2,2 H32 V23 H2 Z M12,29 H22 M17,23 V29" Stroke="#A8BED9" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="34" Height="32" />
                <TextBlock x:Name="PcName" Text="DESKTOP" Margin="0,8,0,0" FontSize="19" FontWeight="SemiBold" Foreground="#C8D5E8" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
    <Window.Triggers><EventTrigger RoutedEvent="Window.Loaded"><BeginStoryboard Storyboard="{StaticResource AmbientMotion}" /><BeginStoryboard Storyboard="{StaticResource GlassBreathing}" /><BeginStoryboard Storyboard="{StaticResource BorderFlow}" /><BeginStoryboard Storyboard="{StaticResource OrbitMotion}" /><BeginStoryboard Storyboard="{StaticResource PhoneMotion}" /><BeginStoryboard Storyboard="{StaticResource OnlinePulse}" /><BeginStoryboard Storyboard="{StaticResource BluetoothPulse}" /></EventTrigger></Window.Triggers>
</Window>
