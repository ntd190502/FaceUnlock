<Window x:Class="FaceUnlock.Shell.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" WindowState="Maximized" Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False" Background="#060914" Foreground="#F8FAFC" FontFamily="Segoe UI">
 <Window.Resources>
  <Storyboard x:Key="Ambient" RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetName="AmbientOne" Storyboard.TargetProperty="Opacity" From=".24" To=".52" Duration="0:0:14"/><DoubleAnimation Storyboard.TargetName="AmbientTwo" Storyboard.TargetProperty="Opacity" From=".38" To=".12" Duration="0:0:18"/></Storyboard>
  <Storyboard x:Key="Orbit" RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="OrbitRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3"/></Storyboard>
  <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetName="DotOne" Storyboard.TargetProperty="Opacity" From=".22" To="1" Duration="0:0:.8" BeginTime="0:0:0"/><DoubleAnimation Storyboard.TargetName="DotTwo" Storyboard.TargetProperty="Opacity" From=".22" To="1" Duration="0:0:.8" BeginTime="0:0:.25"/><DoubleAnimation Storyboard.TargetName="DotThree" Storyboard.TargetProperty="Opacity" From=".22" To="1" Duration="0:0:.8" BeginTime="0:0:.5"/></Storyboard>
  <Storyboard x:Key="Shimmer" RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="Shimmer" Storyboard.TargetProperty="(Canvas.Left)" From="-300" To="700" Duration="0:0:8"/></Storyboard>
 </Window.Resources>
 <Grid ClipToBounds="True">
  <Grid.Background><RadialGradientBrush GradientOrigin=".52,.42" Center=".5,.5" RadiusX=".85" RadiusY=".85"><GradientStop Color="#111A36" Offset="0"/><GradientStop Color="#060914" Offset=".72"/><GradientStop Color="#02030A" Offset="1"/></RadialGradientBrush></Grid.Background>
  <Ellipse x:Name="AmbientOne" Width="1000" Height="700" Fill="#402E6BFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-360,-230,0,0"><Ellipse.Effect><BlurEffect Radius="110"/></Ellipse.Effect></Ellipse>
  <Ellipse x:Name="AmbientTwo" Width="900" Height="580" Fill="#443C1BB8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-300,-160"><Ellipse.Effect><BlurEffect Radius="120"/></Ellipse.Effect></Ellipse>
  <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" MaxHeight="650">
   <Border CornerRadius="34" BorderThickness="1" Padding="48,42,48,34" Background="#A817223B" BorderBrush="#8F9A9DFF">
    <Border.Effect><DropShadowEffect Color="#523C63FF" BlurRadius="36" ShadowDepth="0" Opacity=".55"/></Border.Effect>
    <Grid ClipToBounds="True"><Canvas x:Name="Shimmer" Width="180" Height="600" Opacity=".10"><Canvas.RenderTransform><SkewTransform AngleX="-18"/></Canvas.RenderTransform><Rectangle Width="38" Height="600" Fill="#BDEBFFFF"/></Canvas>
     <StackPanel HorizontalAlignment="Center">
      <Grid Width="144" Height="144" Margin="0,0,0,22"><Ellipse Width="132" Height="132" StrokeThickness="2"><Ellipse.Stroke><LinearGradientBrush><GradientStop Color="#6AB5FF"/><GradientStop Color="#B38AFF" Offset="1"/></LinearGradientBrush></Ellipse.Stroke><Ellipse.RenderTransform><RotateTransform x:Name="OrbitRotate" CenterX="66" CenterY="66"/></Ellipse.RenderTransform></Ellipse><Ellipse Width="9" Height="9" Fill="#C7E7FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,15,0"/><Border Width="52" Height="98" CornerRadius="12" Background="#D8142036" BorderThickness="2" BorderBrush="#B9D8FF" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><DropShadowEffect Color="#5366A8FF" BlurRadius="15" ShadowDepth="0"/></Border.Effect><Grid><Rectangle Width="24" Height="3" RadiusX="2" RadiusY="2" Fill="#91B6E8" VerticalAlignment="Top" Margin="0,10,0,0"/><Ellipse Width="5" Height="5" Fill="#91B6E8" VerticalAlignment="Bottom" Margin="0,0,0,9"/></Grid></Border></Grid>
      <TextBlock x:Name="StatusTitle" Text="Waiting for iPhone" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
      <TextBlock x:Name="StatusDetail" Text="Connecting to your iPhone to unlock" Margin="0,10,0,20" FontSize="14" Foreground="#C3CEDF" HorizontalAlignment="Center" TextAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25"><Ellipse x:Name="DotOne" Width="7" Height="7" Fill="#AFCFFF" Margin="4"/><Ellipse x:Name="DotTwo" Width="7" Height="7" Fill="#AFCFFF" Margin="4"/><Ellipse x:Name="DotThree" Width="7" Height="7" Fill="#AFCFFF" Margin="4"/></StackPanel>
      <Border Height="1" Background="#4A6886A8" Margin="0,0,0,20"/>
      <Grid Width="360"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Ellipse x:Name="OnlineDot" Width="8" Height="8" Fill="#54E49A" Margin="0,4,8,0"/><TextBlock x:Name="OnlineStatus" Text="Online" Foreground="#BFEFD7"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="ᛒ" FontSize="18" Foreground="#8CC7FF" Margin="0,-2,7,0"/><TextBlock x:Name="BluetoothStatus" Text="Bluetooth Ready" Foreground="#C3D9EF"/></StackPanel></Grid>
     </StackPanel>
    </Grid>
   </Border>
   <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-82"><TextBlock Text="▣" FontSize="20" Foreground="#91A9C8" HorizontalAlignment="Center"/><TextBlock x:Name="PcName" Text="DESKTOP" Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#C8D5E8" HorizontalAlignment="Center"/></StackPanel>
  </Grid>
 </Grid>
 <Window.Triggers><EventTrigger RoutedEvent="Window.Loaded"><BeginStoryboard Storyboard="{StaticResource Ambient}"/><BeginStoryboard Storyboard="{StaticResource Orbit}"/><BeginStoryboard Storyboard="{StaticResource Pulse}"/><BeginStoryboard Storyboard="{StaticResource Shimmer}"/></EventTrigger></Window.Triggers>
</Window>
