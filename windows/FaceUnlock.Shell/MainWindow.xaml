<Window x:Class="FaceUnlock.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" WindowState="Maximized" Topmost="True" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#060914" Foreground="#F8FAFC" FontFamily="Segoe UI">
    <Window.Resources>
        <Storyboard x:Key="Ambient" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="AmbientOne" Storyboard.TargetProperty="Opacity" From=".20" To=".45" Duration="0:0:16" />
            <DoubleAnimation Storyboard.TargetName="BlueWaveMove" Storyboard.TargetProperty="X" From="-35" To="35" Duration="0:0:16" />
            <DoubleAnimation Storyboard.TargetName="AmbientTwo" Storyboard.TargetProperty="Opacity" From=".16" To=".38" Duration="0:0:19" />
            <DoubleAnimation Storyboard.TargetName="VioletWaveMove" Storyboard.TargetProperty="X" From="35" To="-35" Duration="0:0:19" />
        </Storyboard>
        <Storyboard x:Key="Orbit" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="OrbitRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3.5" />
        </Storyboard>
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="DotOne" Storyboard.TargetProperty="Opacity" From=".22" To="1" Duration="0:0:.8" />
            <DoubleAnimation Storyboard.TargetName="DotTwo" Storyboard.TargetProperty="Opacity" From=".22" To="1" Duration="0:0:.8" BeginTime="0:0:.25" />
            <DoubleAnimation Storyboard.TargetName="DotThree" Storyboard.TargetProperty="Opacity" From=".22" To="1" Duration="0:0:.8" BeginTime="0:0:.5" />
        </Storyboard>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid.Background>
            <RadialGradientBrush GradientOrigin=".52,.42" Center=".5,.5" RadiusX=".85" RadiusY=".85">
                <GradientStop Color="#111A36" Offset="0" />
                <GradientStop Color="#060914" Offset=".72" />
                <GradientStop Color="#02030A" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>
        <Ellipse x:Name="AmbientOne" Width="1320" Height="420" Fill="#3E206DFF"
                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-520,0,0,0">
            <Ellipse.RenderTransform><TranslateTransform x:Name="BlueWaveMove" /></Ellipse.RenderTransform>
            <Ellipse.Effect><BlurEffect Radius="135" /></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="AmbientTwo" Width="1240" Height="400" Fill="#473C258E"
                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,60,-490,0">
            <Ellipse.RenderTransform><TranslateTransform x:Name="VioletWaveMove" /></Ellipse.RenderTransform>
            <Ellipse.Effect><BlurEffect Radius="135" /></Ellipse.Effect>
        </Ellipse>

        <Grid Width="820" Height="500" Margin="0,-30,0,0"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border CornerRadius="46" BorderThickness="1.25" BorderBrush="#8DADC9FF">
                <Border.Effect><DropShadowEffect Color="#523C63FF" BlurRadius="36" ShadowDepth="0" Opacity=".55" /></Border.Effect>
                <Border CornerRadius="45" Margin="1" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#B61C2C48" Offset="0" />
                            <GradientStop Color="#9410192B" Offset=".48" />
                            <GradientStop Color="#A5191839" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Border Height="46" VerticalAlignment="Top" Opacity=".34">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#70DCF4FF" Offset="0" />
                                    <GradientStop Color="#00DCF4FF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="50,28,50,26">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="172" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="1" /><RowDefinition Height="44" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Width="164" Height="164" HorizontalAlignment="Center">
                                <Ellipse Width="150" Height="150" StrokeThickness="2.5">
                                    <Ellipse.Stroke><LinearGradientBrush><GradientStop Color="#70C5FF" /><GradientStop Color="#B784FF" Offset="1" /></LinearGradientBrush></Ellipse.Stroke>
                                    <Ellipse.RenderTransform><RotateTransform x:Name="OrbitRotate" CenterX="75" CenterY="75" /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Width="9" Height="9" Fill="#D7F2FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,16,0" />
                                <Ellipse Width="7" Height="7" Fill="#C6A2FF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="17,0,0,25" />
                                <Border Width="58" Height="108" CornerRadius="15" Background="#B6142036" BorderThickness="2" BorderBrush="#C2DDFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Effect><DropShadowEffect Color="#6068AFFF" BlurRadius="18" ShadowDepth="0" /></Border.Effect>
                                    <Grid><Rectangle Width="27" Height="4" RadiusX="2" RadiusY="2" Fill="#A2C7EE" VerticalAlignment="Top" Margin="0,11,0,0" /></Grid>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="1" x:Name="StatusTitle" Text="Waiting for iPhone" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Row="2" x:Name="StatusDetail" Text="Connecting to your iPhone to unlock" Margin="0,10,0,0" FontSize="17" Foreground="#B8C5DA" HorizontalAlignment="Center" TextAlignment="Center" />
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="DotOne" Width="9" Height="9" Fill="#AFCFFF" Margin="7" />
                                <Ellipse x:Name="DotTwo" Width="9" Height="9" Fill="#AFCFFF" Margin="7" />
                                <Ellipse x:Name="DotThree" Width="9" Height="9" Fill="#AFCFFF" Margin="7" />
                            </StackPanel>
                            <Border Grid.Row="5" Background="#506C8CA8" />
                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="OnlineDot" Width="10" Height="10" Fill="#54E49A" Margin="0,3,10,0" />
                                    <TextBlock x:Name="OnlineStatus" Text="Online" FontSize="16" Foreground="#BFEFD7" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Path Data="M 8,0 L 20,12 L 13,19 L 20,26 L 8,38 L 8,24 L 1,31 L 1,25 L 8,18 L 1,11 L 1,5 L 8,12 Z" Stroke="#8CC7FF" StrokeThickness="2" Width="20" Height="26" Margin="0,0,10,0" />
                                    <TextBlock x:Name="BluetoothStatus" Text="Bluetooth Ready" FontSize="16" Foreground="#C3D9EF" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-55">
                <Path Data="M2,2 H30 V22 H2 Z M12,27 H20 M16,22 V27" Stroke="#91A9C8" StrokeThickness="2" Width="34" Height="30" />
                <TextBlock x:Name="PcName" Text="DESKTOP" Margin="0,8,0,0" FontSize="19" FontWeight="SemiBold" Foreground="#C8D5E8" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Ambient}" />
            <BeginStoryboard Storyboard="{StaticResource Orbit}" />
            <BeginStoryboard Storyboard="{StaticResource Pulse}" />
        </EventTrigger>
    </Window.Triggers>
</Window>
