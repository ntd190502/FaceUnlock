<Window x:Class="FaceUnlock.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FaceUnlock Shell"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Roboto, Helvetica, Arial, sans-serif">
    <Grid>
        <!-- Background Dark Gradient -->
        <Border Background="#0F172A"/>

        <!-- Main Content Card -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
            <!-- App Icon Shield -->
            <Border Width="72" Height="72" CornerRadius="36" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,24">
                <TextBlock Text="🔒" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#60A5FA"/>
            </Border>

            <!-- App Title -->
            <TextBlock Text="FaceUnlock" FontSize="32" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="ModeBadge" Text="SHELL GATE" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <!-- Status Indicator Card -->
            <Border Background="#1E293B" CornerRadius="12" Padding="20,16" Margin="0,0,0,24" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="StatusTitle" Text="Waiting for iPhone Face ID..." FontSize="18" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="StatusDetail" Text="Please check your paired iPhone to approve Face ID unlock." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Button x:Name="BtnTryAgain" Content="Try Face ID Again" Click="BtnTryAgain_Click" Width="180" Height="42" Margin="0,0,12,0" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" BorderThickness="0" Cursor="Hand" Visibility="Collapsed"/>
                <Button x:Name="BtnRetryDesktop" Content="Retry Desktop" Click="BtnRetryDesktop_Click" Width="180" Height="42" Margin="0,0,12,0" Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" BorderThickness="0" Cursor="Hand" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Test Mode Exit Button -->
            <Button x:Name="BtnExitTest" Content="Close Test Window" Click="BtnExitTest_Click" Width="160" Height="36" Background="Transparent" Foreground="#64748B" FontSize="12" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>

    </Grid>
</Window>
