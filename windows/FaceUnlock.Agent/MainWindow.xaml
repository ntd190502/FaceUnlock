<Window x:Class="FaceUnlock.Agent.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FaceUnlock" Width="650" Height="760">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="FaceUnlock for Windows" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="Status" Margin="0,8,0,8" Text="Ready"/><TextBlock x:Name="SetupStatus" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12"><Button Content="Start pairing" Click="Pair_Click" Margin="0,0,8,0" Padding="12,6"/><Button x:Name="EnableButton" Content="Enable FaceUnlock" Click="Enable_Click" Margin="0,0,8,0" Padding="12,6" Visibility="Collapsed"/><Button Content="Test online Face ID" Click="Online_Click" Margin="0,0,8,0" Padding="12,6"/><Button Content="Test BLE offline" Click="Ble_Click" Padding="12,6"/></StackPanel>
<Image Grid.Row="2" x:Name="QrImage" Width="360" Height="360" Stretch="Uniform"/>
<TextBlock Grid.Row="3" Text="Enabling FaceUnlock changes the Windows Shell only for the next sign-in/restart. Recovery remains available." TextWrapping="Wrap" Margin="0,8"/>
<TextBox Grid.Row="4" x:Name="Log" Margin="0,12,0,0" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
</Grid></Window>
