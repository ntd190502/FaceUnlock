<Window x:Class="FaceUnlock.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FaceUnlock Control" Width="820" Height="760" MinWidth="720" MinHeight="620">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="FaceUnlock for Windows" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="Status" Margin="0,8,0,4" Text="Ready" TextWrapping="Wrap"/><TextBlock x:Name="SetupStatus" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,14,0,10">
            <Button x:Name="PairButton" Content="Start pairing" Click="Pair_Click" Margin="0,0,8,8" Padding="12,6"/><Button x:Name="CancelPairButton" Content="Cancel pairing" Click="CancelPair_Click" Margin="0,0,8,8" Padding="12,6" IsEnabled="False"/><Button x:Name="EnableButton" Content="Enable FaceUnlock" Click="Enable_Click" Margin="0,0,8,8" Padding="12,6" Visibility="Collapsed"/><Button Content="Refresh status" Click="Refresh_Click" Margin="0,0,8,8" Padding="12,6"/><Button Content="Restart Service" Click="RestartService_Click" Margin="0,0,8,8" Padding="12,6"/><Button Content="Open logs" Click="OpenLogs_Click" Margin="0,0,8,8" Padding="12,6"/><Button Content="Monitoring / Telegram" Click="Monitoring_Click" Margin="0,0,8,8" Padding="12,6"/><Button x:Name="OnlineButton" Content="Test online Face ID" Click="Online_Click" Margin="0,0,8,8" Padding="12,6"/><Button x:Name="BleButton" Content="Test BLE offline" Click="Ble_Click" Margin="0,0,8,8" Padding="12,6"/>
        </WrapPanel>
        <Grid Grid.Row="2" Margin="0,4,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="QrImage" Width="340" Height="340" Stretch="Uniform" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="Daily status" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock x:Name="PairingInfo" Text="iPhone: -" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock x:Name="ServiceInfo" Text="Service: -" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock x:Name="ShellInfo" Text="Shell Gate: -" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock x:Name="LastActionInfo" Text="Last action: -" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="Pairing and tests can be cancelled safely. Use Refresh after sleep/wake or network changes to verify current runtime state." TextWrapping="Wrap" Foreground="Gray"/></StackPanel></Grid>
        <TextBox Grid.Row="3" x:Name="Log" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
