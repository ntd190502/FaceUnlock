<Window x:Class="FaceUnlock.Agent.MonitoringSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Monitoring & Telegram" Width="520" Height="520" WindowStartupLocation="CenterOwner"><ScrollViewer><StackPanel Margin="20"><TextBlock Text="PC alerts via Telegram" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/><CheckBox x:Name="TempEnabled" Content="Temperature alert" Margin="0,4"/><TextBlock Text="Temperature limit (°C)"/><TextBox x:Name="TempLimit" Margin="0,4,0,10"/><CheckBox x:Name="RamEnabled" Content="RAM alert" Margin="0,4"/><TextBlock Text="RAM limit (%)"/><TextBox x:Name="RamLimit" Margin="0,4,0,10"/><TextBlock Text="Cooldown (seconds)"/><TextBox x:Name="Cooldown" Margin="0,4,0,10"/><TextBlock Text="Telegram Bot Token"/><PasswordBox x:Name="BotToken" Margin="0,4,0,10"/><TextBlock Text="Telegram Chat ID"/><TextBox x:Name="ChatId" Margin="0,4,0,14"/><WrapPanel><Button Content="Save" Click="Save_Click" Padding="14,7" Margin="0,0,8,0"/><Button Content="Send test message" Click="Test_Click" Padding="14,7"/></WrapPanel><TextBlock x:Name="Result" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Window>
